aws_region             = "us-east-1"
environment            = "prod"
artifacts_bucket_name  = "replace-with-globally-unique-bucket-name"
# Restrict to operator/VPN/public office CIDRs before production use.
admin_cidr_blocks      = ["203.0.113.10/32"]
app_ingress_cidrs      = ["0.0.0.0/0"]
instance_type          = "t3.large"
root_volume_size_gb    = 32
ssh_key_name           = "replace-with-your-ec2-keypair"
repository_ref         = "main"
tsf_api_token_ssm_parameter_name = "/time-series-forecast/prod/tsf_api_token"
database_url           = "sqlite:///Project/output/tasks_prod.db"
