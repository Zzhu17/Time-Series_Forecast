TSF_ENV=prod
# Public frontend origin if you terminate TLS or serve behind a domain, e.g. https://forecast.example.com
TSF_API_URL=
# Required for protected admin/API access. Leave blank only for isolated test environments.
TSF_API_TOKEN=
API_PORT=8000
UI_PORT=8501
# Public frontend origin compiled into the React build, e.g. https://forecast.example.com
VITE_API_URL=
# Replace with a managed database in production when durability matters.
DATABASE_URL=sqlite:///Project/output/tasks_prod.db
CELERY_ENABLED=1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_PORT=6379
